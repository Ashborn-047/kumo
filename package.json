{
  "name": "kumo",
  "version": "0.1.0",
  "description": "Kumo — Animated AI desktop companion & spatial planning canvas for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node dev-server.js",
    "web": "node dev-server.js",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --publish=never"
  },
  "keywords": [
    "desktop-companion",
    "ai-agent",
    "canvas",
    "electron",
    "windows",
    "spatial-planning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1"
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "build": {
    "appId": "com.kumo.app",
    "productName": "Kumo",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}

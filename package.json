{
  "name": "kumo",
  "version": "0.1.1",
  "description": "Kumo — Animated AI desktop companion & spatial planning canvas for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node dev-server.js",
    "web": "node dev-server.js",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:e2e": "playwright test tests/e2e",
    "build": "electron-builder --win",
    "dist": "electron-builder --win nsis portable --publish=never",
    "dist:release": "electron-builder --win nsis portable",
    "dist:setup": "electron-builder --win nsis --publish=never",
    "dist:portable": "electron-builder --win portable --publish=never",
    "release": "powershell -ExecutionPolicy Bypass -File ./release.ps1"
  },
  "keywords": [
    "desktop-companion",
    "ai-agent",
    "canvas",
    "electron",
    "windows",
    "spatial-planning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "openai": "^4.0.0"
  },
  "build": {
    "appId": "com.kumo.app",
    "productName": "Kumo",
    "publish": [
      {
        "provider": "github",
        "owner": "Ashborn-047",
        "repo": "kumo"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kumo",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "design-system/**/*"
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
